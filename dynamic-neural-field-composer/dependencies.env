# Pinned dependency revisions - the single source of truth for CI and the
# local setup scripts. Plain KEY=value so both sh and cmd can read it.
#
# Why: nothing here used to be pinned. Every job ran `git clone` against
# upstream HEAD, so the versions a build resolved depended on the day it ran,
# and a change nobody in this project made could break CI overnight (#117).
#
# To bump a pin: change the SHA, re-run scripts/setup.sh (or setup.bat) against
# a clean prefix, and let CI confirm all four platforms still build. The monthly
# vcpkg report (.github/workflows/vcpkg-maintenance.yml) deliberately keeps
# reading upstream HEAD, so it stays the thing that tells you a pin has aged.

# microsoft/vcpkg
VCPKG_COMMIT=39344dff01c5a5a0134caf2624cdd492f05d30ea

# Jgocunha/imgui-platform-kit
IPK_COMMIT=27ada9152ea705e683de2b31c5986c536e5354e5
