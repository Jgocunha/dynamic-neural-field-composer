# -performance-enum-size: shrinking enum underlying types breaks the
# reinterpret_cast<int*>(&enumVar) pattern required by ImGui::Combo.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  modernize-*,
  -modernize-use-trailing-return-type,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  clang-analyzer-*,
  performance-*,
  -performance-enum-size

# Project headers only; vendored code (user_interface/fonts, user_interface/node_utilities) excluded.
HeaderFilterRegex: 'include[/\\]((application|element_parameters|elements|exceptions|simulation|tools|visualization)[/\\].*|user_interface[/\\][^/\\]+)$'
WarningsAsErrors: '*'
FormatStyle: none
